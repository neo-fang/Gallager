// Copy to Local.xcconfig for personal-device packaging. Local.xcconfig is
// ignored by Git and is the only local iOS identity configuration source.
GALLAGER_IOS_DEVELOPMENT_TEAM = YOUR_TEAM_ID
GALLAGER_IOS_APP_BUNDLE_IDENTIFIER = com.example.gallager.local
GALLAGER_IOS_NOTIFICATION_EXTENSION_BUNDLE_IDENTIFIER = $(GALLAGER_IOS_APP_BUNDLE_IDENTIFIER).ClaudeSpyNotificationExtension
