// Copy to Local.xcconfig for personal-device packaging. Local.xcconfig is
// ignored by Git and is the only local iOS identity configuration source.
CTRLX_IOS_DEVELOPMENT_TEAM = YOUR_TEAM_ID
CTRLX_IOS_APP_BUNDLE_IDENTIFIER = com.jicezeng.ctrlx
CTRLX_IOS_NOTIFICATION_EXTENSION_BUNDLE_IDENTIFIER = com.jicezeng.ctrlx.notification-service
