// Shared.xcconfig
// Shared configuration for iOS targets
// All other settings use Xcode project defaults

#include "Shared-Base.xcconfig"

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = Gallager
PRODUCT_DISPLAY_NAME = Gallager
GALLAGER_IOS_DEVELOPMENT_TEAM = XG2WG7U93U
GALLAGER_IOS_APP_BUNDLE_IDENTIFIER = br.eng.gustavo.claudespy
GALLAGER_IOS_NOTIFICATION_EXTENSION_BUNDLE_IDENTIFIER = $(GALLAGER_IOS_APP_BUNDLE_IDENTIFIER).ClaudeSpyNotificationExtension
PRODUCT_BUNDLE_IDENTIFIER = $(GALLAGER_IOS_APP_BUNDLE_IDENTIFIER)

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 18.0

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = 1,2

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/ClaudeSpy.entitlements to add capabilities
GALLAGER_IOS_APP_ENTITLEMENTS = Config/ClaudeSpy.entitlements
GALLAGER_IOS_NOTIFICATION_EXTENSION_ENTITLEMENTS = ClaudeSpyNotificationExtension/ClaudeSpyNotificationExtension.entitlements
CODE_SIGN_ENTITLEMENTS = $(GALLAGER_IOS_APP_ENTITLEMENTS)

// ==========================================
// Sparkle Auto-Update Support
// ==========================================
// Required for Sparkle.framework to be found at runtime
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
